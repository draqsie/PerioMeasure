# PerioMeasure - Fiji/ImageJ menu entries.
# Format: menu path, "command label", fully.qualified.ClassName
# ASCII ONLY: ImageJ reads this file with the platform charset, so Turkish
# letters would be garbled on some systems (enforced by PluginsConfigTest).
# The PerioMeasure window itself is in Turkish (default) or English.
Plugins>PerioMeasure, "Measure...", com.periomeasure.ui.MeasurePlugin
Plugins>PerioMeasure, "Demo...", com.periomeasure.ui.DemoPlugin
Plugins>PerioMeasure, "Settings...", com.periomeasure.ui.SettingsPlugin
Plugins>PerioMeasure, "About", com.periomeasure.ui.AboutPlugin
